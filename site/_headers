# Cloudflare static-assets _headers: path pattern on a bare line, indented headers below.

/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=86400
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Cache-Control: public, max-age=3600

# Pages are extensionless (/explorer), so they are covered by /* above.
# The sankey data changes only when the explorer is rebuilt.
/explorer-sankey.json
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000

/sitemap.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=86400
